# =============================================================================
# Technology Associates EA Limited — Self-Service Portal — Environment configuration
# Copy to .env.local and adjust per environment.
# =============================================================================

# Toggle mock data on/off. When VITE_AUTH_API_URL is set this defaults to false
# automatically — you only need VITE_USE_MOCK=true if you want mock lists while
# still testing JWT login against the backend.
# VITE_USE_MOCK=false

# -----------------------------------------------------------------------------
# Login backend — "our backend" (Node JWT API, way #2)
# -----------------------------------------------------------------------------
# Base URL of the Node auth server (folder: ../server). When set, the app uses
# real JWT login against it. Leave EMPTY to use mock auto-login during dev.
# Local backend for development. Switch to your Vercel URL when you deploy.
VITE_AUTH_API_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# Legacy real backend (Laravel ESS) — only used if no Node auth API is set
# -----------------------------------------------------------------------------
# Base URL of the deployed Laravel app. The React app calls /api/* on this host
# only for legacy ESS endpoints.
# Leave empty to use the same origin (when React is served from the Laravel
# app's public/ folder).
VITE_ESS_API_URL=http://192.168.224.37:81

# -----------------------------------------------------------------------------
# Application metadata
# -----------------------------------------------------------------------------
VITE_APP_NAME=Self Service Portal

# -----------------------------------------------------------------------------
# Legacy: direct Business Central OData connection. Only used if you bypass
# the Laravel layer. Leave empty unless you know what you're doing.
# -----------------------------------------------------------------------------
# VITE_ERP_BASE_URL=
# VITE_TOKEN_URL=
# VITE_CLIENT_ID=
# VITE_CLIENT_SECRET=
# VITE_ERP_COMPANY_ID=
