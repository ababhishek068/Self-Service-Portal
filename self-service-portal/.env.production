# =============================================================================
# Production build config.
#
# CURRENT: Vercel public demo.
#   - Login goes to our Node backend on Vercel (real auth against TiDB).
#   - App data stays mocked, because the bank's Laravel backend is on an
#     internal network that Vercel cannot reach.
# =============================================================================
VITE_USE_MOCK=true
VITE_AUTH_API_URL=https://self-service-portal-y1me.vercel.app
VITE_APP_NAME=Self Service Portal

# -----------------------------------------------------------------------------
# REAL on-prem deployment (bank network / IIS) — switch to these when deploying
# inside the bank, where the Laravel ESS backend is reachable:
#   VITE_USE_MOCK=false
#   VITE_ESS_API_URL=http://192.168.224.37:81
#   VITE_AUTH_API_URL=<the internal URL of the Node backend>
# -----------------------------------------------------------------------------
